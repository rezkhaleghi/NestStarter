NODE_ENV=production
PORT=3000

# Set according to your reverse proxy/load balancer setup.
TRUST_PROXY=1

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=replace-me
DB_PASSWORD=replace-me
DB_NAME=replace-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-me

# OTP
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_LOG_CODE=false

# Login protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900

# Optional first-admin bootstrap.
# Remove these after the initial admin is created.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=replace-me@example.com

# Session
SESSION_SECRET=replace-with-at-least-32-random-characters

# Google OAuth
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=https://api.example.com/auth/google/callback

# Frontend
FRONTEND_URL=https://app.example.com

# MinIO
MINIO_ENDPOINT=replace-me
MINIO_PORT=9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=replace-me

DEFAULT_CURRENCY=USD